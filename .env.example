# Copy to .env.local (gitignored) and fill in. Never commit real keys.
# Mapbox PUBLIC access token (starts with "pk."), from https://account.mapbox.com/access-tokens/
# EXPO_PUBLIC_* vars are inlined into the JS bundle — use a public token restricted to this
# app's bundle ID / URLs, never a secret ("sk.") token.
EXPO_PUBLIC_MAPS_API_KEY=
